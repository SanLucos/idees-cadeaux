# Copier ce fichier en .env (non versionné) et ajuster si besoin.
# Ce fichier ne doit contenir aucun secret réel.

# --- docker-compose ---
HOST_UID=1000
HOST_GID=1000

POSTGRES_DB=idees_cadeaux
POSTGRES_USER=idees_cadeaux
POSTGRES_PASSWORD=idees_cadeaux
POSTGRES_LOCAL_PORT=5433

MAILPIT_UI_PORT=8026
MAILPIT_SMTP_PORT=1026

BACKEND_LOCAL_PORT=8000

# Garage (stockage S3 de dev). Clé au format Garage : GK + 24 hex, secret 64 hex.
STORAGE_BUCKET=idees-cadeaux
STORAGE_KEY=GK1dc0de1dc0de1dc0de1dc0de
STORAGE_SECRET=1dc0de1dc0de1dc0de1dc0de1dc0de1dc0de1dc0de1dc0de1dc0de1dc0de1dc0
GARAGE_S3_PORT=3900
