<!DOCTYPE html>
<html>
<body style="font-family: sans-serif; color: #1a1a1a;">
    <p style="font-size: 18px;">{{ (new_account ? 'sign_in.heading_new' : 'sign_in.heading')|trans({}, 'emails') }}</p>
    <p>{{ 'sign_in.intro_link'|trans({}, 'emails') }}</p>
    <p style="margin: 24px 0;">
        <a href="{{ link }}" style="background: #A94A2A; color: #FFFCF7; padding: 12px 24px; border-radius: 8px; text-decoration: none; font-weight: bold;">{{ 'sign_in.button'|trans({}, 'emails') }}</a>
    </p>
    <p>{{ 'sign_in.intro_code'|trans({}, 'emails') }}</p>
    <p style="font-size: 32px; font-weight: bold; letter-spacing: 8px; margin: 24px 0;">{{ code }}</p>
    <p style="color: #666;">{{ 'sign_in.expiry'|trans({}, 'emails') }}</p>
    <p style="color: #999; font-size: 13px;">{{ 'sign_in.ignore'|trans({}, 'emails') }}</p>
    <p style="color: #999; font-size: 13px;">{{ app_name }}</p>
</body>
</html>
