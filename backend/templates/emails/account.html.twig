<!DOCTYPE html>
<html>
<body style="font-family: sans-serif; color: #1a1a1a;">
    <p style="font-size: 18px;">{{ (prefix ~ 'heading')|trans(params, 'emails') }}</p>
    <p>{{ (prefix ~ 'body' ~ (kind == 'export_ready' ? suffix : ''))|trans(params, 'emails') }}</p>
    {% if action_url %}
        <p style="margin: 24px 0;"><a href="{{ action_url }}" style="display: inline-block; padding: 12px 20px; border-radius: 12px; background: #A94A2A; color: #FFFCF7; text-decoration: none; font-weight: bold;">{{ (prefix ~ 'action')|trans(params, 'emails') }}</a></p>
    {% endif %}
    {% if kind == 'deletion_requested' %}
        <p style="color: #666;">{{ (prefix ~ 'hint')|trans(params, 'emails') }}</p>
        <p style="color: #999; font-size: 13px;">{{ (prefix ~ 'ignore')|trans(params, 'emails') }}</p>
    {% elseif kind == 'export_ready' %}
        <p style="color: #666;">{{ (prefix ~ 'expiry')|trans(params, 'emails') }}</p>
    {% endif %}
    <p style="color: #999; font-size: 13px;">{{ app_name }}</p>
</body>
</html>
