<!DOCTYPE html>
<html>
<body style="font-family: sans-serif; color: #1a1a1a;">
    <p style="font-size: 18px;">{{ (translation_key ~ '.heading')|trans({}, 'emails') }}</p>
    <p>{{ (translation_key ~ '.intro')|trans({}, 'emails') }}</p>
    <p style="font-size: 32px; font-weight: bold; letter-spacing: 8px; margin: 24px 0;">{{ code }}</p>
    <p style="color: #666;">{{ (translation_key ~ '.expiry')|trans({}, 'emails') }}</p>
    <p style="color: #999; font-size: 13px;">{{ (translation_key ~ '.ignore')|trans({}, 'emails') }}</p>
    <p style="color: #999; font-size: 13px;">{{ app_name }}</p>
</body>
</html>
