<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{% endblock %} · {{ app_name }}</title>
    <style>
        body { margin: 0; padding: 32px 20px 64px; background: #F6F0E6; color: #2B211C; font-family: 'Helvetica Neue', system-ui, sans-serif; line-height: 1.55; }
        main { max-width: 720px; margin: 0 auto; }
        h1 { font-family: Georgia, serif; font-weight: 400; font-size: 32px; margin: 0 0 8px; }
        h2 { font-size: 19px; margin: 32px 0 8px; }
        .muted { color: #6A5D53; font-size: 14px; }
        .todo { background: #F5E1D6; color: #6E2F1A; padding: 0 4px; border-radius: 4px; }
        table { width: 100%; border-collapse: collapse; font-size: 15px; }
        th, td { text-align: left; vertical-align: top; padding: 8px; border-bottom: 1px solid #E4D8C6; }
        a { color: #A94A2A; }
    </style>
</head>
<body><main>{% block body %}{% endblock %}</main></body>
</html>
