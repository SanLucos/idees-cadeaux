# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
# Real value in .env.local (not committed).
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> app ###
# Provisional name (CLAUDE.md §8 / spec §2): never hard-code elsewhere.
APP_NAME="Idées Cadeaux"
###< app ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# The keypair itself (config/jwt/*.pem) is gitignored and generated
# per-environment, so this passphrase only protects a key nobody
# commits — fine to share across dev/test. .env.local is NOT loaded for
# APP_ENV=test (Symfony convention), so a per-machine override here
# would silently break `bin/phpunit`; override in production secrets
# instead. Regenerate together with the keys:
#   bin/console lexik:jwt:generate-keypair --overwrite
JWT_PASSPHRASE=changeme
###< lexik/jwt-authentication-bundle ###

###> symfony/mailer ###
MAILER_DSN=null://null
MAILER_FROM_ADDRESS=no-reply@idees-cadeaux.example
###< symfony/mailer ###

###> app/social-login ###
# Connexion Google/Apple (spec §5.1). Placeholders: to fill in once the
# Google Cloud / Apple Developer OAuth clients exist (see readme).
GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com
APPLE_CLIENT_ID=com.example.ideescadeaux.service
###< app/social-login ###

###> app/storage ###
# S3-compatible object storage (spec §2/§9). Values below match the
# docker-compose MinIO service; docker-compose.yaml overrides them for
# the php container regardless of what's here.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/idees-cadeaux
STORAGE_BUCKET=idees-cadeaux
STORAGE_KEY=idees_cadeaux
# Real value in .env.local (not committed).
STORAGE_SECRET=changeme
STORAGE_REGION=us-east-1
###< app/storage ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> push (spec §5.11) ###
# Firebase Cloud Messaging HTTP v1. Empty = push disabled (the in-app
# centre and email still work). FCM_SERVICE_ACCOUNT_JSON is the service
# account key file's JSON content, on one line. Never commit a real one.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
###< push ###

###> share link (spec §5.16) ###
# Public base of share links (https://<domaine>/u/<token>); the domain
# comes with the final app name (lot 8). This backend serves the page.
SHARE_LINK_BASE_URL=http://localhost:8000
# App id (same as mobile APP_ID): custom scheme of « Ouvrir dans l'appli »
# and the App Links / Universal Links files under /.well-known.
APP_ID=com.example.ideescadeaux
# Store pages (empty = not shown on the guest web page).
APP_STORE_URL=
PLAY_STORE_URL=
# App Links (Android): comma-separated SHA-256 certificate fingerprints.
# Universal Links (iOS): Apple team id. Empty = file not served.
ANDROID_CERT_FINGERPRINTS=
APPLE_TEAM_ID=
###< share link ###
