# Copier en .env (non versionné) pour surcharger localement.
# Aucun secret ici : uniquement des identifiants publics de build.

# Lus par capacitor.config.ts (contexte Node, à la génération native).
APP_ID=fr.frigologie.ideescadeaux
APP_NAME=Idées Cadeaux

# Exposés au bundle web par Vite (doivent être préfixés VITE_).
VITE_APP_NAME=Idées Cadeaux
# Web app (dev and production): the API on the same origin (Vite relays /api in dev).
# Android/iOS builds use .env.native instead: npm run build -- --mode native.
VITE_API_BASE_URL=/api
