# Android/iOS builds (npm run build -- --mode native && npx cap sync):
# the app runs in the device's WebView, so the API needs its full address.
# For a local backend on an emulator, override in .env.native.local
# (e.g. http://10.0.2.2:8000/api).
VITE_API_BASE_URL=https://ideescadeaux.frigologie.fr/api

# Page title of the native builds too.
VITE_APP_NAME=Idées Cadeaux
