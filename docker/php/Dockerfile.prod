# Production images, built from the repo root (see docker-compose.prod.yaml):
#   --target php    PHP-FPM with the backend code (also runs the worker)
#   --target nginx  nginx with the web app and the backend's public/ directory

# The web app (spec §11 décision 56): the Ionic Vue app built for the
# browser, its API on the same origin.
FROM node:22-alpine AS web
WORKDIR /app
ENV CYPRESS_INSTALL_BINARY=0
COPY mobile/package.json mobile/package-lock.json ./
COPY mobile/scripts ./scripts
RUN npm ci --no-audit --no-fund
COPY mobile/ ./
RUN VITE_API_BASE_URL=/api npm run build

FROM php:8.3-fpm AS php

RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq-dev \
        libicu-dev \
        libzip-dev \
        libpng-dev \
        libjpeg62-turbo-dev \
        libfreetype6-dev \
        libwebp-dev \
        unzip \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install -j"$(nproc)" \
        pdo_pgsql \
        intl \
        zip \
        gd \
        exif \
        opcache \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"
COPY docker/php/prod.ini $PHP_INI_DIR/conf.d/zz-prod.ini

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

ENV APP_ENV=prod APP_DEBUG=0

WORKDIR /var/www/backend
RUN chown www-data:www-data /var/www/backend
USER www-data

COPY --chown=www-data:www-data backend/composer.json backend/composer.lock backend/symfony.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction --no-progress

COPY --chown=www-data:www-data backend/ ./
# Secrets and URLs come from real environment variables at runtime: the
# committed backend/.env defaults are enough to compile the container here.
RUN composer dump-autoload --no-dev --classmap-authoritative \
    && mkdir -p config/jwt \
    && php bin/console cache:clear \
    && php bin/console assets:install public

# The web app's page, for the /u/<token> link previews (WEB_APP_INDEX).
COPY --from=web /app/dist/index.html /var/www/web/index.html

FROM nginx:alpine AS nginx

COPY docker/nginx/prod.vhost.conf /etc/nginx/conf.d/default.conf
COPY --from=php /var/www/backend/public /var/www/backend/public
COPY --from=web /app/dist /var/www/web
