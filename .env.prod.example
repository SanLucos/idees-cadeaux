# Copier ce fichier en .env.prod sur le serveur (non versionné) et remplir
# les valeurs. Lu par docker-compose.prod.yaml et passé aux conteneurs php
# et worker. Voir docs/DEPLOIEMENT.md.

# --- Traefik (stack hôte) ---
APP_HOST=ideescadeaux.frigologie.fr
TRAEFIK_NETWORK=proxy
TRAEFIK_CERT_RESOLVER=le

# --- Données (dossiers de l'hôte, créés par deploy-prod.sh) ---
DATA_DIR=/srv/ideescadeaux

# --- PostgreSQL ---
# Mot de passe sans caractère spécial d'URL (@ : / ? #) : il est repris
# tel quel dans DATABASE_URL.
POSTGRES_DB=idees_cadeaux
POSTGRES_USER=idees_cadeaux
POSTGRES_PASSWORD=

# --- MinIO (stockage des images, interne à la stack) ---
MINIO_ROOT_USER=idees_cadeaux
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=idees-cadeaux

# --- Symfony ---
APP_SECRET=
JWT_PASSPHRASE=
MAILER_DSN=smtp://user:pass@smtp.example.com:587
MAILER_FROM_ADDRESS=no-reply@frigologie.fr

# --- Connexion Google / Apple (spec §5.1) ---
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# --- Push FCM (spec §5.11), vide = push désactivé ---
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# --- Lien de partage (spec §5.16) ---
APP_ID=com.example.ideescadeaux
APP_STORE_URL=
PLAY_STORE_URL=
ANDROID_CERT_FINGERPRINTS=
APPLE_TEAM_ID=
